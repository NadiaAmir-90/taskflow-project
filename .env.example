# --- AI chat model (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Smaller = stricter matches. Tune it if search returns too much or too little.
SEARCH_MAX_DISTANCE=0.75

# --- Storage ---
DATABASE_URL=sqlite:///./data/tasks.db
CHROMA_PATH=./data/chroma

# --- Server ---
APP_HOST=127.0.0.1
APP_PORT=8000